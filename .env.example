# Copy to .env and adjust. Everything has a safe local default.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///data/flyte.db
SEED_DEMO=1                 # 1 = fill an empty database with ~3 months of demo data
FLASK_DEBUG=1
APP_TIMEZONE=Africa/Lagos   # flight times are local to this zone
# APP_ENV=production        # turns on secure cookies, turns off demo seeding
# ADMIN_EMAIL=you@yourairline.ng
# ADMIN_PASSWORD=a-strong-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Flyte <hello@flyte.ng>
